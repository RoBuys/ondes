{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ondes",
  "version": "0.1.0",
  "identifier": "com.robertbuys.ondes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ondes",
        "width": 1320,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0d0f14",
        "additionalBrowserArgs": "--disable-web-security --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Video",
    "shortDescription": "Lecteur IPTV",
    "longDescription": "Ondes lit vos playlists IPTV (M3U, Xtream Codes) avec guide des programmes, films et séries.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["French", "English"], "displayLanguageSelector": false },
      "wix": { "language": "fr-FR" }
    }
  }
}
